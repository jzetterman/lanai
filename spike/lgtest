#!/usr/bin/env bash
# lgtest: harness for the Looking Glass software mode vs RDP spike.
# See docs/spike/plan.md. Run `lgtest help` for the subcommands.
set -euo pipefail

# Pins: one Looking Glass build for client and IDD, plus the SPICE guest agent.
LG_BUILD=B7-826-236efcb1
LG_SOURCE_URL=https://looking-glass.io/artifact/$LG_BUILD/source
LG_SOURCE_SHA=e396d923172ff3e6e88a1c6906a0e5e87a298ddb5a18aa4d8cb4da37e78ce250
LG_IDD_URL=https://looking-glass.io/artifact/$LG_BUILD/idd
LG_IDD_SHA=34daa6ddb403c1f503fb2ace94360159818fda1795fc5c2be5cec1f4391d5d57
VDAGENT_URL=https://www.spice-space.org/download/windows/vdagent/vdagent-win-0.10.0/spice-vdagent-x64-0.10.0.msi
VDAGENT_SHA=77629435705bc27dd7d2525e9d2084f72dbab5fdbf310e812f91332fe18d00eb

SPIKE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
WORK=$SPIKE/work
ASSETS=$SPIKE/assets
RUN=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/lgtest

# Print an error and exit.
die() {
  printf 'lgtest: %s\n' "$*" >&2
  exit 1
}

# Check <file> against a SHA-256 sum. On mismatch, delete the file and fail,
# so a bad download never lingers. Used by fetch for every pin.
verify_sha256() {
  local file=$1 want=$2 got
  got=$(sha256sum -- "$file") || return 1
  got=${got%% *}
  if [[ $got != "$want" ]]; then
    rm -f -- "$file"
    printf 'lgtest: SHA-256 mismatch for %s: got %s, want %s (file deleted)\n' \
      "$file" "$got" "$want" >&2
    return 1
  fi
}

# Print the command line of every QEMU process, one argument per line, with a
# blank line after each process. Matches on argv[0], bare or with a path, so a
# shell that only mentions QEMU is ignored. Empty output means no QEMU runs.
# LGTEST_PROC swaps /proc for a fixture tree.
qemu_cmdlines() {
  local f argv0
  for f in "${LGTEST_PROC:-/proc}"/[0-9]*/cmdline; do
    argv0=""
    IFS= read -r -d '' argv0 <"$f" 2>/dev/null || [[ -n $argv0 ]] || continue
    [[ ${argv0##*/} == qemu-system-x86_64 ]] || continue
    tr '\0' '\n' <"$f" 2>/dev/null || continue
    echo
  done
  return 0
}

# Print host CPU busy time in seconds from the `cpu` line of /proc/stat:
# user + nice + system + irq + softirq. Guest time already sits inside user
# and nice; idle, iowait and steal are not host work. LGTEST_STAT swaps the file.
host_busy_seconds() {
  local hz
  hz=$(getconf CLK_TCK)
  awk -v hz="$hz" '$1 == "cpu" { printf "%.2f\n", ($2 + $3 + $4 + $7 + $8) / hz; found = 1 }
    END { exit !found }' "${LGTEST_STAT:-/proc/stat}"
}

# Print the median busy seconds of the baseline rows (<length>,<busy_seconds>)
# whose length is <seconds>. Fails when there are none. Used by measure.
baseline_median() {
  local csv=$1 secs=$2
  [[ -r $csv ]] || {
    echo "lgtest: no baseline file $csv" >&2
    return 1
  }
  awk -F, -v s="$secs" '$1 == s { print $2 }' "$csv" | sort -g |
    awk -v s="$secs" '{ v[NR] = $1 }
      END {
        if (NR == 0) { print "lgtest: no " s " s baseline rows" > "/dev/stderr"; exit 1 }
        m = (NR % 2) ? v[(NR + 1) / 2] : (v[NR / 2] + v[NR / 2 + 1]) / 2
        printf "%.2f\n", m
      }'
}

usage() {
  cat <<'EOF'
usage: lgtest <command> [args]
  fetch | build | prepare | capture | run [--setup] [--expose-loopback]
  client | rdp | baseline | stop
  measure <label> --task <n> --transport <lg|rdp|rdp-real> --mode <fullscreen|tiled>
          --res <WxH> --scale <pct> --hz <n> [--seconds <n>]
  record <label> [seconds] [--region WxH+X+Y] | snap <label> | frames <label> <w:h:x:y>
EOF
}

# Dispatch a subcommand.
main() {
  local cmd=${1:-help}
  shift || true
  case $cmd in
    help | -h | --help) usage ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
