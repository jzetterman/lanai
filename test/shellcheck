#!/usr/bin/env bash
# Run shellcheck on every shell file in the repo, one process per file in
# parallel. A shell file is a .sh, .bash or .bats file, or one whose first line
# is a bash, sh or bats shebang, so new scripts are checked without a list.
# bin/check and CI both run this script.
set -euo pipefail
cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.."

files=()
while IFS= read -r -d '' f; do
  case $f in
    *.sh | *.bash | *.bats) files+=("$f") ;;
    *) IFS= read -r line <"$f" || true
       [[ $line =~ ^\#!.*(bash|/sh|bats) ]] && files+=("$f") ;;
  esac
done < <(find . \( -path ./.git -o -path ./.btrfs-test -o -path ./spike/work \) -prune \
  -o -type f -print0)
((${#files[@]})) || { echo "test/shellcheck: no shell files found" >&2; exit 1; }
# xargs exits non-zero when any shellcheck fails.
printf '%s\0' "${files[@]}" | xargs -0 -n1 -P "$(nproc)" shellcheck -x
