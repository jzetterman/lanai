+
+/* Called at the start of each display session, while the frame thread is
+ * stopped, so nothing else writes l_resizeFrame. */
+void core_resizeSession(void)
+{
+  atomic_store_explicit(&l_resizeFrame, 0, memory_order_relaxed);
+  l_resize.lastCount = 0;
+  l_resize.haveToken = false;
+  resize_session(&l_resize.state);
+}
+
+/* Called by the frame thread for each accepted format change. */
+void core_resizeFrame(unsigned width, unsigned height)
+{
+  const uint64_t old =
+    atomic_load_explicit(&l_resizeFrame, memory_order_relaxed);
+  const uint32_t count = (uint32_t)old + 1;
+  atomic_store_explicit(&l_resizeFrame,
+      (uint64_t)(width  & 0xffff) << 48 |
+      (uint64_t)(height & 0xffff) << 32 |
+      count,
+      memory_order_release);
+}
+
+/* Called by the main loop about every 100ms while the session is valid. */
+void core_resizeUpdate(void)
+{
+  const uint64_t now   = microtime();
+  const uint64_t value =
+    atomic_load_explicit(&l_resizeFrame, memory_order_acquire);
+  const uint32_t count = (uint32_t)value;
+  if (count != l_resize.lastCount)
+  {
+    resize_frame(&l_resize.state, value >> 48, (value >> 32) & 0xffff,
+        count - l_resize.lastCount, now);
+    l_resize.lastCount = count;
+  }
+
+  resize_update(&l_resize.state, now, resizeResponding(now));
+}
+
+void core_onWindowSizeChanged(unsigned width, unsigned height)
+{
+  resize_window(&l_resize.state, width, height);
 }
 
