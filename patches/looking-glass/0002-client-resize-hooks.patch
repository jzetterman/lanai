+/* Count the lines holding `text` that the client logs while `fn` runs. */
+static unsigned int countLogged(const char * text, void (*fn)(void))
+{
+  fflush(stderr);
+  FILE * capture = tmpfile();
+  CHECK(capture);
+  const int saved = dup(STDERR_FILENO);
+  CHECK(saved >= 0);
+  CHECK(dup2(fileno(capture), STDERR_FILENO) >= 0);
+
+  fn();
+
+  fflush(stderr);
+  CHECK(dup2(saved, STDERR_FILENO) >= 0);
+  CHECK(close(saved) == 0);
+
+  unsigned int count = 0;
+  char line[1024];
+  rewind(capture);
+  while (fgets(line, sizeof(line), capture))
+    if (strstr(line, text))
+      ++count;
+  fclose(capture);
+  return count;
+}
