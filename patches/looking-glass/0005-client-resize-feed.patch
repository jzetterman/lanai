+/* 0004: an ask waits until the window has held its size for 2 s. Move the
+ * clock to 2 s after the last post, then make one pass. */
+static void settle(void)
+{
+  if (t.now < t.lastPost + SETTLE_US)
+    step(t.lastPost + SETTLE_US - t.now);
+  process();
+}
