+  post(1600, 900);
+  run(1800 * UINT64_C(1000));
+  CHECK(t.send == 0);
+
+  post(1700, 950);
+  run(SETTLE_US - POLL_US);
+  CHECK(t.send == 0);
+  run(POLL_US);
+  CHECK(t.send == 1);
+  checkCtl(0, 1700, 950);
+  lgMessage_deinit();
