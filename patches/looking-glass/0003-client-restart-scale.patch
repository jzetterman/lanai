+// Moves the local pointer to (700,400) and checks that the guest gets the
+// position at twice that: the frame is twice the window in each direction.
+static void checkScaledMove(void)
+{
+  m.positions = 0;
+  core_handleMousePosition(700, 400);
+  CHECK(m.positions == 1);
+  CHECK(m.posX == 1400);
+  CHECK(m.posY == 800);
+}
+
+// A host restart keeps the pointer scale that the frame size and the window
+// set; only a reset before the first frame goes back to 1.0.
+static void testRestartScale(void)
+{
+  bool absolute = true;
+  lgInput_setFallback(&inputOps, &absolute);
+  reset();
+  g_state.windowW = 1576;
+  g_state.windowH = 950;
+  g_state.srcSize = (struct Point) { 3152, 1900 };
+
+  core_updatePositionInfo();
+  CHECK(g_cursor.useScale);
+  checkScaledMove();
+
+  core_resetPointerScale();
+  checkScaledMove();
+  CHECK(g_cursor.useScale);
+
+  g_state.haveSrcSize = false;
+  core_resetPointerScale();
+  CHECK(!g_cursor.useScale);
+  CHECK(near(g_cursor.scale.x, 1.0));
+  CHECK(near(g_cursor.scale.y, 1.0));
+
+  lgInput_setFallback(&inputOps, NULL);
+}
