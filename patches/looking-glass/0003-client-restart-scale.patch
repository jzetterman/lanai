diff -Naur lg-pristine/client/src/core.c lg-working/client/src/core.c
--- lg-pristine/client/src/core.c	2026-10-26 00:57:14.339499137 +0000
+++ lg-working/client/src/core.c	2026-10-26 01:26:33.418990752 +0000
@@ -556,6 +556,22 @@
   resize_window(&l_resize.state, width, height);
 }
 
+/* Called by lgInit at the start of each session. The pointer scale comes
+ * from the frame size and the window (core_updatePositionInfo). A host
+ * restart by itself changes neither, and a frame of a new size recomputes
+ * the scale. A new session at the same frame size does not, so a reset here
+ * would leave it at 1.0 and map the window onto part of the guest. Reset it
+ * only before the first frame. */
+void core_resetPointerScale(void)
+{
+  if (!g_state.haveSrcSize)
+  {
+    g_cursor.useScale      = false;
+    g_cursor.scale.x       = 1.0;
+    g_cursor.scale.y       = 1.0;
+  }
+}
+
 void core_updatePositionInfo(void)
 {
   g_cursor.motionValid = false;
