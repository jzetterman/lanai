+/* Log a stall once: no frame for RESIZE_STALL_US since the session started,
+ * or while an ask is outstanding. */
+static void checkStall(ResizeState * this, uint64_t now)
+{
+  if (this->sessionPending)
+  {
+    this->sessionPending = false;
+    this->haveSessionAt  = true;
+    this->sessionAt      = now;
+  }
+
+  if (this->stalled)
+    return;
+
+  if (!this->sessionFrame && this->haveSessionAt &&
+      now >= this->sessionAt + RESIZE_STALL_US)
+  {
+    this->stalled = true;
+    resizeLog(this, "Resize: no frame from Windows for 10 s (new session)");
+    return;
+  }
+
+  if (!this->haveFrame || this->asks == 0 ||
+      (this->guestW == this->windowW && this->guestH == this->windowH))
+    return;
+
+  uint64_t from = this->firstAsk;
+  if (this->haveLastFrame && this->lastFrame > from)
+    from = this->lastFrame;
+
+  if (now >= from + RESIZE_STALL_US)
+  {
+    this->stalled = true;
+    resizeLog(this, "Resize: no frame from Windows for 10 s (asked for %ux%u)",
+        this->windowW, this->windowH);
+  }
+}
+
 void resize_update(ResizeState * this, uint64_t now, bool responding)
 {
+  checkStall(this, now);
+
   if (!this->haveFrame || !this->windowW || !this->windowH)
     return;
 
@@ -148,9 +218,18 @@
   if (this->asks > 0 && now < this->lastAsk + resizeWait[this->asks - 1])
     return;
 
+  /* the window must hold its size, and asks keep their distance */
+  if (this->haveRaw && now < this->rawAt + RESIZE_SETTLE_US)
+    return;
+
+  if (this->haveAsk && now < this->lastAsk + RESIZE_GAP_US)
+    return;
+
   if (!this->send(this->opaque, this->windowW, this->windowH))
     return;
 
+  if (this->asks == 0)
+    this->firstAsk = now;
   ++this->asks;
   this->haveAsk = true;
   this->lastAsk = now;
