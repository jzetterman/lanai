+/* 0004 cases: the settle, the gap and the stall detector. */
+
+/* A raw window size posted now, before the client's debounce. */
+static void raw(unsigned width, unsigned height)
+{
+  resize_raw(&t.rs, width, height, t.now);
+}
+
+/* The window moves to a new size now: the raw post, then the debounced size
+ * 500 ms later, as message.c hands it on. */
+static void resized(unsigned width, unsigned height)
+{
+  raw(width, height);
+  runTo(t.now + MS(500));
+  window(width, height);
+}
+
+/* A frame that changes nothing. */
+static void seen(void)
+{
+  resize_seen(&t.rs, t.now);
+}
+
+/* No two asks are closer than 4 s. */
+static void checkGaps(void)
+{
+  for (unsigned i = 1; i < t.asks; ++i)
+    CHECK(t.ask[i].at >= t.ask[i - 1].at + SEC(4));
+}
+
+/* A guest at 1920x1080 in a window that matches it, from T0. */
+static void matched(void)
+{
+  start();
+  frame(1920, 1080);
+  raw(1920, 1080);
+  window(1920, 1080);
+  poll();
+  CHECK(t.asks == 0);
+}
+
+static void testBurst(void)
+{
+  /* Three sizes 0.7 s apart, as a monitor wake makes: one ask, for the last
+   * size, 2 s after its raw post. */
+  matched();
+  runTo(T0 + SEC(10));
+  const uint64_t t1 = t.now;
+  resized(1600, 900);
+  runTo(t1 + MS(700));
+  resized(1700, 950);
+  runTo(t1 + MS(1400));
+  resized(1800, 1000);
+
+  runTo(t1 + MS(3400) - POLL_US);
+  CHECK(t.asks == 0);
+  runTo(t1 + MS(3400));
+  CHECK(t.asks == 1);
+  checkAsk(0, t1 + MS(3400), 1800, 1000);
+
+  /* Nothing more until the first retry, 4 s later. */
+  runTo(t1 + MS(7400) - POLL_US);
+  CHECK(t.asks == 1);
+}
+
+static void testDrag(void)
+{
+  /* A raw change every 0.3 s for 10 s, with the module told of each size:
+   * no ask until 2 s after the drag stops. */
+  matched();
+  runTo(T0 + SEC(10));
+  const uint64_t t1 = t.now;
+  unsigned width = 1600;
+  for (uint64_t at = t1; at <= t1 + SEC(10); at += MS(300), width += 8)
+  {
+    runTo(at);
+    raw(width, 900);
+    window(width, 900);
+  }
+  const uint64_t last = t.now;
+  const unsigned lastW = width - 8;
+
+  runTo(last + SEC(2) - POLL_US);
+  CHECK(t.asks == 0);
+  runTo(last + SEC(2));
+  CHECK(t.asks == 1);
+  checkAsk(0, last + SEC(2), lastW, 900);
+}
+
+static void testGap(void)
+{
+  /* With no raw change on record, the first ask goes out at once. */
+  start();
+  frame(1920, 1080);
+  window(1600, 900);
+  poll();
+  CHECK(t.asks == 1);
+  checkAsk(0, T0, 1600, 900);
+
+  /* A new size 1 s later settles at 3 s, but the gap holds it to 4 s. */
+  runTo(T0 + SEC(1));
+  raw(1700, 950);
+  window(1700, 950);
+  runTo(T0 + SEC(4) - POLL_US);
+  CHECK(t.asks == 1);
+  runTo(T0 + SEC(4));
+  CHECK(t.asks == 2);
+  checkAsk(1, T0 + SEC(4), 1700, 950);
+
+  /* Its retry waits the 4 s gap too, and a third size that settles 0.5 s
+   * after that retry still waits 4 s from it. */
+  runTo(T0 + SEC(8));
+  CHECK(t.asks == 3);
+  checkAsk(2, T0 + SEC(8), 1700, 950);
+  runTo(T0 + MS(6500));
+  raw(1800, 1000);
+  window(1800, 1000);
+  runTo(T0 + SEC(12));
+  CHECK(t.asks == 4);
+  checkAsk(3, T0 + SEC(12), 1800, 1000);
+
+  runTo(T0 + SEC(120));
+  checkGaps();
+}
+
+static void testWindowsChange(void)
+{
+  /* The window holds one size for 100 s, then Windows changes resolution:
+   * the settle is met, so the ask goes out at once. */
+  start();
+  raw(1600, 900);
+  window(1600, 900);
+  frame(1600, 900);
+  runTo(T0 + SEC(100));
+  frame(1024, 768);
+  poll();
+  CHECK(t.asks == 1);
+  checkAsk(0, T0 + SEC(100), 1600, 900);
+
+  /* Windows takes it 1 s later and leaves it again 1 s after that: the next
+   * ask goes out 4 s after the last one, no later (0004: was 2 s). */
+  runTo(T0 + SEC(101));
+  frame(1600, 900);
+  runTo(T0 + SEC(102));
+  frame(1024, 768);
+  runTo(T0 + SEC(104) - POLL_US);
+  CHECK(t.asks == 1);
+  runTo(T0 + SEC(104));
+  CHECK(t.asks == 2);
+  checkAsk(1, T0 + SEC(104), 1600, 900);
+}
+
+static void testStall(void)
+{
+  /* An ask, one frame 1 s later, then silence: one stall line, 10 s after
+   * that frame. The retries at 4 and 9 s do not move it. */
+  start();
+  frame(1920, 1080);
+  window(1600, 900);
+  poll();
+  CHECK(t.asks == 1);
+  runTo(T0 + SEC(1));
+  seen();
+
+  runTo(T0 + SEC(11) - POLL_US);
+  CHECK(t.asks == 3);
+  CHECK(countLines("no frame from Windows") == 0);
+  runTo(T0 + SEC(11));
+  CHECK(countLines("no frame from Windows") == 1);
+  const unsigned line = lastLine("no frame from Windows");
+  checkLine(line,
+      "Resize: no frame from Windows for 10 s (asked for 1600x900)");
+  CHECK(t.line[line].at == T0 + SEC(11));
+
+  /* Once per stall. */
+  runTo(T0 + SEC(120));
+  CHECK(countLines("no frame from Windows") == 1);
+}
+
+static void testStallFrom(void)
+{
+  /* The deadline counts from the first ask when the last frame is older. */
+  start();
+  frame(1920, 1080);
+  runTo(T0 + SEC(30));
+  window(1600, 900);
+  poll();
+  runTo(T0 + SEC(40) - POLL_US);
+  CHECK(countLines("no frame from Windows") == 0);
+  runTo(T0 + SEC(40));
+  CHECK(countLines("no frame from Windows") == 1);
+
+  /* A matched window has no ask outstanding: no stall however long. */
+  matched();
+  runTo(T0 + SEC(120));
+  CHECK(countLines("no frame from Windows") == 0);
+}
+
+static void testFramesAgain(void)
+{
+  /* A frame of any size before each deadline: no stall line. */
+  start();
+  frame(1920, 1080);
+  window(1600, 900);
+  poll();
+  for (unsigned i = 1; i <= 6; ++i)
+  {
+    runTo(T0 + MS(9900) * i);
+    if (i % 2)
+      seen();
+    else
+      frame(1920, 1080);
+  }
+  const uint64_t last = t.now;
+  CHECK(countLines("no frame from Windows") == 0);
+
+  /* Then silence: the stall, and the next frame ends it. */
+  runTo(last + SEC(10));
+  CHECK(countLines("no frame from Windows") == 1);
+  CHECK(t.line[lastLine("no frame from Windows")].at == last + SEC(10));
+  runTo(last + SEC(15));
+  seen();
+  CHECK(countLines("frames from Windows again") == 1);
+  checkLine(t.lines - 1, "Resize: frames from Windows again");
+}
+
+static void testSessionStall(void)
+{
+  /* A new session with no frame for 10 s. */
+  start();
+  window(1600, 900);
+  runTo(T0 + SEC(10) - POLL_US);
+  CHECK(countLines("no frame from Windows") == 0);
+  runTo(T0 + SEC(10));
+  CHECK(countLines("no frame from Windows") == 1);
+  checkLine(t.lines - 1,
+      "Resize: no frame from Windows for 10 s (new session)");
+
+  /* A session whose first frame comes in time logs nothing. */
+  start();
+  runTo(T0 + SEC(9));
+  frame(1600, 900);
+  runTo(T0 + SEC(60));
+  CHECK(countLines("no frame from Windows") == 0);
+}
+
+static void testStallSession(void)
+{
+  /* A stall, then a new session (a driver restart), then a frame: one stall
+   * line and one "frames again", with no second stall for the session. */
+  start();
+  frame(1920, 1080);
+  window(1600, 900);
+  runTo(T0 + SEC(10));
+  CHECK(countLines("no frame from Windows") == 1);
+
+  runTo(T0 + SEC(15));
+  resize_session(&t.rs);
+  runTo(T0 + SEC(40));
+  CHECK(countLines("no frame from Windows") == 1);
+  CHECK(countLines("frames from Windows again") == 0);
+
+  frame(1600, 900);
+  CHECK(countLines("frames from Windows again") == 1);
+  runTo(T0 + SEC(120));
+  CHECK(countLines("no frame from Windows") == 1);
+  CHECK(countLines("frames from Windows again") == 1);
+}
+
+static void testRawOrder(void)
+{
+  /* The debounce can hand an older post back after a newer one: it does not
+   * move the settle back, nor change the size it waits on. */
+  matched();
+  runTo(T0 + SEC(10));
+  const uint64_t t1 = t.now;
+  resize_raw(&t.rs, 1600, 900, t1);
+  resize_raw(&t.rs, 1700, 950, t1 + SEC(1));
+  resize_raw(&t.rs, 1600, 900, t1);
+  window(1700, 950);
+  runTo(t1 + SEC(3) - POLL_US);
+  CHECK(t.asks == 0);
+  runTo(t1 + SEC(3));
+  CHECK(t.asks == 1);
+  checkAsk(0, t1 + SEC(3), 1700, 950);
+}
