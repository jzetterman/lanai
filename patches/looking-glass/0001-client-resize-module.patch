+#ifndef _H_LG_RESIZE_
+#define _H_LG_RESIZE_
+
+/* Decides when to ask the guest for the window's size. Pure: the caller owns
+ * the clock, the transport and the log, and passes the time in microseconds.
+ * Every call must come from one thread.
+ *
+ * A trigger (a new window size, a new display session's first frame, or a
+ * change of the guest's size) that finds the guest at another size asks at
+ * once, then again after waits of 5, 10, 20 and 40 seconds, each counted from
+ * the previous ask, while the guest still differs, then stops. A change of the
+ * guest's size within 60 seconds of the last ask continues that sequence. No
+ * ask is made for a window under 640x480, the smallest mode the IDD takes. */
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define RESIZE_MIN_WIDTH  640U
+#define RESIZE_MIN_HEIGHT 480U
+#define RESIZE_MAX_ASKS   5U
+
+/* Ask the guest for width x height. Returns true when the ask went out. */
+typedef bool (*ResizeSendFn)(void * opaque, unsigned width, unsigned height);
+
+/* Log one line of text (no newline). */
+typedef void (*ResizeLogFn)(void * opaque, const char * line);
+
+typedef struct ResizeState
+{
+  ResizeSendFn send;
+  ResizeLogFn  log;
+  void       * opaque;
+
+  /* the window's size in guest pixels, kept across sessions, 0 until known */
+  unsigned windowW, windowH;
+
+  /* the guest's size, valid once a frame was seen this session */
+  bool     haveFrame;
+  unsigned guestW, guestH;
+
+  /* the current sequence */
+  unsigned asks;
+  bool     haveAsk;
+  uint64_t lastAsk;
+  bool     gaveUp;
+}
+ResizeState;
+
+void resize_init(ResizeState * this, ResizeSendFn send, ResizeLogFn log,
+    void * opaque);
+
+/* A new display session: forget the guest's size and the last ask. */
+void resize_session(ResizeState * this);
+
+/* The window's size changed. */
+void resize_window(ResizeState * this, unsigned width, unsigned height);
+
+/* A frame was accepted at width x height after `changes` format changes since
+ * the previous call. */
+void resize_frame(ResizeState * this, unsigned width, unsigned height,
+    unsigned changes, uint64_t now);
+
+/* Ask when an ask is due. `responding` is true when the guest can take an
+ * ask now (its driver is connected and has read the previous ask). */
+void resize_update(ResizeState * this, uint64_t now, bool responding);
+
+#endif
diff -Naur lg-pristine/client/tests/resize_test.c lg-working/client/tests/resize_test.c
--- lg-pristine/client/tests/resize_test.c	1970-01-01 00:00:00.000000000 +0000
+++ lg-working/client/tests/resize_test.c	2026-10-13 03:19:24.353761908 +0000
@@ -0,0 +1,590 @@
+/**
+ * Looking Glass
+ * Copyright (C) 2026 John Zetterman
+ * https://looking-glass.io
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the Free
+ * Software Foundation; either version 2 of the License, or (at your option)
+ * any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for
+ * more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with this program; if not, write to the Free Software Foundation, Inc., 59
+ * Temple Place, Suite 330, Boston, MA 02111-1307 USA
+ */
+
+/* Tests for resize.c with a fake clock, a recording send and a recording log.
+ * It needs only resize.h and the C library, so it builds on its own:
+ *
+ *   cc -std=gnu11 -Isrc src/resize.c tests/resize_test.c
+ *
+ * Run one case by name, or --list to print every case. */
+
+#include "resize.h"
+
+#include <inttypes.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(x) \
+  do \
+  { \
+    if (!(x)) \
+    { \
+      fprintf(stderr, "check failed at %s:%d: %s\n", __FILE__, __LINE__, #x); \
+      exit(EXIT_FAILURE); \
+    } \
+  } \
+  while (0)
+
+#define SEC(x)  ((uint64_t)(x) * UINT64_C(1000000))
+#define MS(x)   ((uint64_t)(x) * UINT64_C(1000))
+#define POLL_US MS(100)
+#define T0      SEC(1000)
+#define MAX_REC 64U
+
+struct Ask
+{
+  uint64_t at;
+  unsigned width;
+  unsigned height;
+};
+
+struct Line
+{
+  uint64_t at;
+  char     text[128];
+};
+
+static struct
+{
+  ResizeState rs;
+  uint64_t    now;
+  bool        responding;
+  bool        sendFails;
+  unsigned    sendCalls;
+  unsigned    asks;
+  struct Ask  ask[MAX_REC];
+  unsigned    lines;
+  struct Line line[MAX_REC];
+}
+t;
+
+static bool fakeSend(void * opaque, unsigned width, unsigned height)
+{
+  CHECK(opaque == &t);
+  ++t.sendCalls;
+  if (t.sendFails)
+    return false;
+
+  CHECK(t.asks < MAX_REC);
+  t.ask[t.asks++] = (struct Ask){ t.now, width, height };
+  return true;
+}
+
+static void fakeLog(void * opaque, const char * text)
+{
+  CHECK(opaque == &t);
+  CHECK(t.lines < MAX_REC);
+  CHECK(strlen(text) < sizeof(t.line[0].text));
+  t.line[t.lines].at = t.now;
+  strcpy(t.line[t.lines].text, text);
+  ++t.lines;
+}
+
+static void start(void)
+{
+  memset(&t, 0, sizeof(t));
+  t.now        = T0;
+  t.responding = true;
+  resize_init(&t.rs, fakeSend, fakeLog, &t);
+  resize_session(&t.rs);
+}
+
+static void window(unsigned width, unsigned height)
+{
+  resize_window(&t.rs, width, height);
+}
+
+static void frames(unsigned width, unsigned height, unsigned changes)
+{
+  resize_frame(&t.rs, width, height, changes, t.now);
+}
+
+static void frame(unsigned width, unsigned height)
+{
+  frames(width, height, 1);
+}
+
+static void poll(void)
+{
+  resize_update(&t.rs, t.now, t.responding);
+}
+
+/* Poll now, then every 100 ms, as the client's main loop does, up to and
+ * including the time `until`. */
+static void runTo(uint64_t until)
+{
+  poll();
+  while (t.now + POLL_US <= until)
+  {
+    t.now += POLL_US;
+    poll();
+  }
+}
+
+static void checkAsk(unsigned no, uint64_t at, unsigned width,
+    unsigned height)
+{
+  CHECK(no < t.asks);
+  CHECK(t.ask[no].at     == at);
+  CHECK(t.ask[no].width  == width);
+  CHECK(t.ask[no].height == height);
+}
+
+/* The number of log lines that contain `text`. */
+static unsigned countLines(const char * text)
+{
+  unsigned count = 0;
+  for (unsigned i = 0; i < t.lines; ++i)
+    if (strstr(t.line[i].text, text))
+      ++count;
+  return count;
+}
+
+static void checkLine(unsigned no, const char * text)
+{
+  CHECK(no < t.lines);
+  if (strcmp(t.line[no].text, text) != 0)
+  {
+    fprintf(stderr, "line %u is \"%s\", want \"%s\"\n",
+        no, t.line[no].text, text);
+    exit(EXIT_FAILURE);
+  }
+}
+
+static void testUnknown(void)
+{
+  /* No ask before a frame, even with the window size known. */
+  start();
+  window(1600, 900);
+  runTo(T0 + SEC(30));
+  CHECK(t.sendCalls == 0);
+
+  /* No ask before the window size is known, even with a frame. */
+  start();
+  frame(1920, 1080);
+  runTo(T0 + SEC(30));
+  CHECK(t.sendCalls == 0);
+
+  /* Both known: the ask goes out on the next poll. */
+  window(1600, 900);
+  poll();
+  CHECK(t.asks == 1);
+  checkAsk(0, T0 + SEC(30), 1600, 900);
+}
+
+static void testFirstFrame(void)
+{
+  start();
+  window(1600, 900);
+  t.now = T0 + SEC(2);
+  frame(1920, 1080);
+  poll();
+  CHECK(t.asks == 1);
+  checkAsk(0, T0 + SEC(2), 1600, 900);
+
+  /* A first frame that matches asks nothing, ever. */
+  start();
+  window(1600, 900);
+  frame(1600, 900);
+  runTo(T0 + SEC(600));
+  CHECK(t.sendCalls == 0);
+}
+
+static void testNeverTakes(void)
+{
+  start();
+  window(1600, 900);
+  frame(1920, 1080);
+  runTo(T0 + SEC(80) + SEC(600));
+
+  CHECK(t.asks == 5);
+  checkAsk(0, T0          , 1600, 900);
+  checkAsk(1, T0 + SEC( 5), 1600, 900);
+  checkAsk(2, T0 + SEC(15), 1600, 900);
+  checkAsk(3, T0 + SEC(35), 1600, 900);
+  checkAsk(4, T0 + SEC(75), 1600, 900);
+
+  CHECK(countLines("did not take") == 1);
+  checkLine(t.lines - 1, "Resize: Windows did not take 1600x900");
+  CHECK(t.line[t.lines - 1].at == T0 + SEC(80));
+}
+
+static void testMatchStops(void)
+{
+  start();
+  window(1600, 900);
+  frame(1920, 1080);
+  runTo(T0 + SEC(2));
+  CHECK(t.asks == 1);
+
+  frame(1600, 900);
+  runTo(T0 + SEC(300));
+  CHECK(t.asks == 1);
+  CHECK(countLines("did not take") == 0);
+}
+
+static void testResponding(void)
+{
+  start();
+  window(1600, 900);
+  frame(1920, 1080);
+  t.responding = false;
+  runTo(T0 + SEC(30));
+  CHECK(t.sendCalls == 0);
+
+  /* The held ask goes out at once and is the first of the sequence; the
+   * next wait counts from that send. */
+  t.now += MS(50);
+  t.responding = true;
+  const uint64_t sent = t.now;
+  runTo(sent + SEC(20));
+  CHECK(t.asks == 3);
+  checkAsk(0, sent, 1600, 900);
+  checkAsk(1, sent + SEC( 5), 1600, 900);
+  checkAsk(2, sent + SEC(15), 1600, 900);
+  checkLine(t.lines - 3, "Resize: asking Windows for 1600x900 (1 of 5)");
+
+  /* Not responding when the next ask is due holds it; it goes out once the
+   * guest responds, and the wait after it counts from then. */
+  t.responding = false;
+  runTo(sent + SEC(40));
+  CHECK(t.asks == 3);
+  t.responding = true;
+  runTo(sent + SEC(40) + SEC(40));
+  CHECK(t.asks == 5);
+  checkAsk(3, sent + SEC(40), 1600, 900);
+  checkAsk(4, sent + SEC(80), 1600, 900);
+}
+
+static void testNewerSize(void)
+{
+  start();
+  window(1600, 900);
+  frame(1920, 1080);
+  t.responding = false;
+  runTo(T0 + SEC(3));
+  window(1700, 950);
+  runTo(T0 + SEC(6));
+  CHECK(t.sendCalls == 0);
+
+  t.responding = true;
+  t.now += POLL_US;
+  poll();
+  CHECK(t.asks == 1);
+  checkAsk(0, t.now, 1700, 950);
+  CHECK(countLines("asking") == 1);
+  checkLine(t.lines - 1, "Resize: asking Windows for 1700x950 (1 of 5)");
+}
+
+static void testSendFails(void)
+{
+  start();
+  window(1600, 900);
+  frame(1920, 1080);
+  t.sendFails = true;
+  poll();
+  t.now += POLL_US;
+  poll();
+  CHECK(t.sendCalls == 2);
+  CHECK(countLines("asking") == 0);
+
+  /* The failures did not count: the first ask that goes out is 1 of 5, and
+   * the next waits 5 s from it. */
+  t.sendFails = false;
+  t.now += POLL_US;
+  const uint64_t sent = t.now;
+  runTo(sent + SEC(5));
+  CHECK(t.asks == 2);
+  checkAsk(0, sent, 1600, 900);
+  checkAsk(1, sent + SEC(5), 1600, 900);
+  checkLine(t.lines - 2, "Resize: asking Windows for 1600x900 (1 of 5)");
+  checkLine(t.lines - 1, "Resize: asking Windows for 1600x900 (2 of 5)");
+}
+
+static void testNewWindow(void)
+{
+  start();
+  window(1600, 900);
+  frame(1920, 1080);
+  runTo(T0 + SEC(20));
+  CHECK(t.asks == 3);
+
+  /* A new window size starts over: at once, 1 of 5, then 5 s later. */
+  window(1700, 950);
+  runTo(T0 + SEC(25));
+  CHECK(t.asks == 5);
+  checkAsk(3, T0 + SEC(20), 1700, 950);
+  checkAsk(4, T0 + SEC(25), 1700, 950);
+  checkLine(t.lines - 2, "Resize: asking Windows for 1700x950 (1 of 5)");
+  checkLine(t.lines - 1, "Resize: asking Windows for 1700x950 (2 of 5)");
+}
+
+static void testFloor(void)
+{
+  static const unsigned sizes[][2] = { { 639, 800 }, { 800, 479 } };
+  for (unsigned i = 0; i < 2; ++i)
+  {
+    char want[128];
+    start();
+    frame(1920, 1080);
+    window(sizes[i][0], sizes[i][1]);
+    runTo(T0 + SEC(300));
+    CHECK(t.sendCalls == 0);
+    CHECK(t.lines == 1);
+    snprintf(want, sizeof(want),
+        "Resize: window is %ux%u, under 640x480, not asking",
+        sizes[i][0], sizes[i][1]);
+    checkLine(0, want);
+  }
+
+  /* 640x480 is allowed. */
+  start();
+  frame(1920, 1080);
+  window(640, 480);
+  poll();
+  CHECK(t.asks == 1);
+  checkAsk(0, T0, 640, 480);
+  checkLine(0, "Resize: window is 640x480");
+}
+
+static void testFloorGrow(void)
+{
+  start();
+  frame(1920, 1080);
+  window(639, 800);
+  runTo(T0 + SEC(100));
+  CHECK(t.sendCalls == 0);
+
+  window(800, 600);
+  poll();
+  CHECK(t.asks == 1);
+  checkAsk(0, T0 + SEC(100), 800, 600);
+}
+
+static void testSession(void)
+{
+  start();
+  window(1600, 900);
+  frame(1920, 1080);
+  runTo(T0 + SEC(80));
+  CHECK(t.asks == 5);
+
+  /* A new session within 60 s of the last ask still starts over, at its
+   * first frame, and keeps the window size. */
+  resize_session(&t.rs);
+  runTo(T0 + SEC(90));
+  CHECK(t.asks == 5);
+
+  t.now += MS(30);
+  const uint64_t first = t.now;
+  frame(1024, 768);
+  runTo(first + SEC(5));
+  CHECK(t.asks == 7);
+  checkAsk(5, first, 1600, 900);
+  checkAsk(6, first + SEC(5), 1600, 900);
+  checkLine(t.lines - 2, "Resize: asking Windows for 1600x900 (1 of 5)");
+}
+
+static void testSixPicks(void)
+{
+  start();
+  window(1600, 900);
+  frame(1600, 900);
+  runTo(T0 + SEC(100));
+  CHECK(t.sendCalls == 0);
+
+  /* Each pick is made after Windows took the previous ask, and before the
+   * next wait ends, so the asks keep their schedule. */
+  static const unsigned picks[][2] =
+  {
+    { 1280,  720 }, { 1024, 768 }, { 1920, 1080 },
+    { 1280, 1024 }, { 1366, 768 }, { 1280,  800 },
+  };
+  static const unsigned askAt[] = { 0, 5, 15, 35, 75 };
+  const uint64_t t1 = T0 + SEC(100);
+
+  for (unsigned i = 0; i < 6; ++i)
+  {
+    /* the pick lands 2 s after Windows took the previous ask */
+    if (i > 0)
+    {
+      runTo(t1 + SEC(askAt[i - 1]) + SEC(1));
+      frame(1600, 900);
+      runTo(t1 + SEC(askAt[i - 1]) + SEC(3));
+    }
+    frame(picks[i][0], picks[i][1]);
+    if (i < 5)
+      runTo(t1 + SEC(askAt[i]));
+  }
+
+  runTo(t1 + SEC(75) + SEC(600));
+  CHECK(t.asks == 5);
+  for (unsigned i = 0; i < 5; ++i)
+    checkAsk(i, t1 + SEC(askAt[i]), 1600, 900);
+
+  /* The sixth pick stays: "did not take" once, 5 s after the fifth ask. */
+  CHECK(countLines("did not take") == 1);
+  checkLine(t.lines - 1, "Resize: Windows did not take 1600x900");
+  CHECK(t.line[t.lines - 1].at == t1 + SEC(80));
+}
+
+static void testLateChange(void)
+{
+  start();
+  window(1600, 900);
+  frame(1920, 1080);
+  runTo(T0 + SEC(6));
+  CHECK(t.asks == 2);
+  frame(1600, 900);
+
+  /* Windows leaves the size more than 60 s after the last ask: a new
+   * sequence, 1 of 5, at once. */
+  runTo(T0 + SEC(5) + SEC(61));
+  frame(1024, 768);
+  poll();
+  CHECK(t.asks == 3);
+  checkAsk(2, T0 + SEC(66), 1600, 900);
+  checkLine(t.lines - 1, "Resize: asking Windows for 1600x900 (1 of 5)");
+
+  /* An exhausted sequence starts over too. */
+  runTo(T0 + SEC(66) + SEC(80));
+  CHECK(t.asks == 7);
+  CHECK(countLines("did not take") == 1);
+  runTo(T0 + SEC(66) + SEC(75) + SEC(61));
+  frame(1280, 720);
+  poll();
+  CHECK(t.asks == 8);
+  checkLine(t.lines - 1, "Resize: asking Windows for 1600x900 (1 of 5)");
+}
+
+static void testSameSize(void)
+{
+  start();
+  window(1600, 900);
+  frame(1920, 1080);
+  runTo(T0 + SEC(200));
+  CHECK(t.asks == 5);
+
+  /* One format change at the same size is no change of Windows' size. */
+  frames(1920, 1080, 1);
+  runTo(T0 + SEC(300));
+  CHECK(t.asks == 5);
+
+  /* Two (Windows left the size and came back between two polls) are. */
+  frames(1920, 1080, 2);
+  poll();
+  CHECK(t.asks == 6);
+  checkAsk(5, T0 + SEC(300), 1600, 900);
+  checkLine(t.lines - 1, "Resize: asking Windows for 1600x900 (1 of 5)");
+}
+
+static void testReplaced(void)
+{
+  start();
+  window(1600, 900);
+  frame(1920, 1080);
+  runTo(T0 + SEC(20));
+  CHECK(t.asks == 3);
+
+  /* A new window size replaces the sequence before its fifth ask, and
+   * Windows takes the new size. */
+  window(1700, 950);
+  poll();
+  t.now += SEC(1);
+  frame(1700, 950);
+  runTo(T0 + SEC(600));
+  CHECK(t.asks == 4);
+  CHECK(countLines("did not take") == 0);
+}
+
+static void testLogLines(void)
+{
+  start();
+  window(1600, 900);
+  window(1600, 900);
+  frame(1920, 1080);
+  runTo(T0 + SEC(5));
+  window(1600, 900);
+  window(1700, 950);
+  poll();
+
+  CHECK(t.lines == 5);
+  checkLine(0, "Resize: window is 1600x900");
+  checkLine(1, "Resize: asking Windows for 1600x900 (1 of 5)");
+  checkLine(2, "Resize: asking Windows for 1600x900 (2 of 5)");
+  checkLine(3, "Resize: window is 1700x950");
+  checkLine(4, "Resize: asking Windows for 1700x950 (1 of 5)");
+}
+
+struct Test
+{
+  const char * name;
+  void (*run)(void);
+};
+
+static const struct Test tests[] =
+{
+  { "unknown"    , testUnknown    },
+  { "first-frame", testFirstFrame },
+  { "never-takes", testNeverTakes },
+  { "match-stops", testMatchStops },
+  { "responding" , testResponding },
+  { "newer-size" , testNewerSize  },
+  { "send-fails" , testSendFails  },
+  { "new-window" , testNewWindow  },
+  { "floor"      , testFloor      },
+  { "floor-grow" , testFloorGrow  },
+  { "session"    , testSession    },
+  { "six-picks"  , testSixPicks   },
+  { "late-change", testLateChange },
+  { "same-size"  , testSameSize   },
+  { "replaced"   , testReplaced   },
+  { "log-lines"  , testLogLines   },
+};
+
+int main(int argc, char ** argv)
+{
+  if (argc != 2)
+  {
+    fprintf(stderr, "usage: %s <case>|--list\n", argv[0]);
+    return EXIT_FAILURE;
+  }
+
+  const unsigned count = sizeof(tests) / sizeof(tests[0]);
+  if (strcmp(argv[1], "--list") == 0)
+  {
+    for (unsigned i = 0; i < count; ++i)
+      printf("%s\n", tests[i].name);
+    return 0;
+  }
+
+  for (unsigned i = 0; i < count; ++i)
+    if (strcmp(argv[1], tests[i].name) == 0)
+    {
+      tests[i].run();
+      return 0;
+    }
+
+  fprintf(stderr, "unknown test: %s\n", argv[1]);
+  return EXIT_FAILURE;
+}
