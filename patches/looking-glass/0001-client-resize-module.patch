+ * more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with this program; if not, write to the Free Software Foundation, Inc., 59
+ * Temple Place, Suite 330, Boston, MA 02111-1307 USA
+ */
+
+#include "resize.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#define RESIZE_SEC(x)      ((uint64_t)(x) * UINT64_C(1000000))
+#define RESIZE_CONTINUE_US RESIZE_SEC(60)
+#define RESIZE_GIVEUP_US   RESIZE_SEC(5)
+
+/* the wait after ask 1, 2, 3 and 4 */
+static const uint64_t resizeWait[RESIZE_MAX_ASKS - 1] =
+{
+  RESIZE_SEC(5), RESIZE_SEC(10), RESIZE_SEC(20), RESIZE_SEC(40)
+};
+
+__attribute__((format(printf, 2, 3)))
+static void resizeLog(ResizeState * this, const char * fmt, ...)
+{
+  char line[128];
+  va_list args;
+  va_start(args, fmt);
+  vsnprintf(line, sizeof(line), fmt, args);
+  va_end(args);
+  this->log(this->opaque, line);
+}
+
+static void newSequence(ResizeState * this)
+{
+  this->asks   = 0;
+  this->gaveUp = false;
+}
+
+static bool underFloor(const ResizeState * this)
+{
+  return this->windowW < RESIZE_MIN_WIDTH ||
+    this->windowH < RESIZE_MIN_HEIGHT;
+}
+
+void resize_init(ResizeState * this, ResizeSendFn send, ResizeLogFn log,
+    void * opaque)
+{
+  memset(this, 0, sizeof(*this));
+  this->send   = send;
+  this->log    = log;
+  this->opaque = opaque;
+}
+
+void resize_session(ResizeState * this)
+{
+  this->haveFrame = false;
+  this->guestW    = 0;
+  this->guestH    = 0;
+  this->haveAsk   = false;
+  this->lastAsk   = 0;
+  newSequence(this);
+}
+
+void resize_window(ResizeState * this, unsigned width, unsigned height)
+{
+  if (width == this->windowW && height == this->windowH)
+    return;
+
+  this->windowW = width;
+  this->windowH = height;
+  newSequence(this);
+
+  if (underFloor(this))
+    resizeLog(this, "Resize: window is %ux%u, under %ux%u, not asking",
+        width, height, RESIZE_MIN_WIDTH, RESIZE_MIN_HEIGHT);
+  else
+    resizeLog(this, "Resize: window is %ux%u", width, height);
+}
+
+void resize_frame(ResizeState * this, unsigned width, unsigned height,
+    unsigned changes, uint64_t now)
+{
+  if (!this->haveFrame)
+  {
+    this->haveFrame = true;
+    this->guestW    = width;
+    this->guestH    = height;
+    newSequence(this);
+    return;
+  }
+
+  /* The same size is no change, unless the format changed twice since the
+   * last call: the guest left the size and came back between two polls. */
+  if (width == this->guestW && height == this->guestH && changes < 2)
+    return;
+
+  this->guestW = width;
+  this->guestH = height;
+
+  /* a change soon after an ask continues its sequence, so a Windows that
+   * keeps leaving the size cannot cause a loop */
+  if (this->haveAsk && now - this->lastAsk <= RESIZE_CONTINUE_US)
+    return;
+
+  newSequence(this);
+}
+
+void resize_update(ResizeState * this, uint64_t now, bool responding)
+{
+  if (!this->haveFrame || !this->windowW || !this->windowH)
+    return;
+
+  if (this->guestW == this->windowW && this->guestH == this->windowH)
+    return;
+
+  if (underFloor(this))
+    return;
+
+  if (this->asks >= RESIZE_MAX_ASKS)
+  {
+    if (!this->gaveUp && now >= this->lastAsk + RESIZE_GIVEUP_US)
+    {
+      resizeLog(this, "Resize: Windows did not take %ux%u",
+          this->windowW, this->windowH);
+      this->gaveUp = true;
+    }
+    return;
+  }
+
+  if (!responding)
+    return;
+
+  if (this->asks > 0 && now < this->lastAsk + resizeWait[this->asks - 1])
+    return;
+
+  if (!this->send(this->opaque, this->windowW, this->windowH))
+    return;
+
+  ++this->asks;
+  this->haveAsk = true;
+  this->lastAsk = now;
+  resizeLog(this, "Resize: asking Windows for %ux%u (%u of %u)",
+      this->windowW, this->windowH, this->asks, RESIZE_MAX_ASKS);
+}
